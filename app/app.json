{
  "expo": {
    "name": "Remind",
    "slug": "artyu-todo",
    "owner": "artyusans-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Remind to record audio notes for your tasks."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#004184"
      },
      "package": "com.remind.app",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "com.android.alarm.permission.SET_ALARM",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0078B7",
          "sounds": []
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Remind to record audio notes for your tasks."
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-speech-recognition"
    ],
    "extra": {
      "eas": {
        "projectId": "f60e39da-f8f8-4fcf-a073-d00749668db3"
      }
    }
  }
}
