# ==========================================
# Remind Backend Environment Configuration
# ==========================================

# Server Port and Environment
PORT=5000
NODE_ENV=development

# MongoDB Connection URI
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/remind
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/remind?retryWrites=true&w=majority

# JWT Authentication Secret & Token Expiry
JWT_SECRET=remind_super_secret_jwt_key_development_change_in_production_2026
JWT_EXPIRES_IN=30d

# Initial Admin Credentials (used for initial setup & /admin login)
ADMIN_EMAIL=admin@remind.local
ADMIN_PASSWORD=AdminSecurePassword123!

# CORS Allowed Origins (comma-separated or * for development)
CORS_ORIGIN=*

# Rate Limiting (windowMs in ms, max requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Audit Event Auto-Expiration TTL in Days (default 7 days)
EVENT_TTL_DAYS=7

