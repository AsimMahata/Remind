# ==============================================================================
# Monorepo (app / backend) .gitignore
# ==============================================================================

# Dependencies
node_modules/
**/node_modules/
package-lock.json.bak
.pnpm-store
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Expo / React Native (app/)
.expo/
**/.expo/
.expo-shared/
web-build/
dist/
**/dist/

# EAS Build & Native Artifacts
.eas/
*.apk
*.aab

# Native Directories (Expo Managed Workflow)
android/
ios/
app/android/
app/ios/

# Signing & Keystores (DO NOT COMMIT SECRETS)
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro / Bundler
.metro/
metro-cache/
*.jsbundle
*.bundle

# Local SQLite / Databases
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Backend build & runtime
backend/dist/
backend/.tsbuildinfo
dist/

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# TypeScript cache
*.tsbuildinfo

# Environment & Secret files (Never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
!.env.example
!**/.env.example

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor & IDE Directories
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json
.project
.classpath
.settings/

# Temporary / Scratch assets
ref-img/
**/ref-img/